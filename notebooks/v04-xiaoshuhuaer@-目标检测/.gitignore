# results: keep small json/md, ignore heavy artifacts
results/**
!results/**/
!results/**/*.json
!results/**/*.md

*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.npz
*.zip
*.tar
*.tar.gz
.ipynb_checkpoints/
__pycache__/
*.pyc
.env
.env.*
!.env.example
